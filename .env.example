# ---- Future Mirror AI configuration (copy to .env) ----
# Database (docker compose)
POSTGRES_DB=future_mirror
POSTGRES_USER=fm
POSTGRES_PASSWORD=change-me-db

# Application
FM_ENVIRONMENT=development            # development | test | production
FM_SECRET_KEY=replace-with-64-random-characters-for-jwt-signing-in-production-0000
FM_ACCESS_TOKEN_MINUTES=480
FM_SEED_DEMO_DATA=true
FM_DEMO_PASSWORD=FutureMirror!2026
FM_PRESENTATION_PACING_MS=450         # visible pause between stages (reported separately from compute time)
FM_HTTP_PORT=8080

# LLM provider (optional). "none" = rule-based agents, clearly labelled in the UI.
FM_LLM_PROVIDER=none                  # none | anthropic | openai | ollama
FM_LLM_MODEL=
FM_ANTHROPIC_API_KEY=
FM_OPENAI_API_KEY=
FM_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Automation (optional). Consequential external actions stay disabled.
FM_N8N_BASE_URL=                      # e.g. http://n8n:5678
FM_N8N_API_KEY=
# Used by the n8n workflows in automation/n8n (all optional; see its README)
# FM_N8N_FROM_EMAIL=future-mirror@example.com
# FM_N8N_ALERT_EMAIL=approvers@example.com
# FM_N8N_HR_EMAIL=hr@example.com
# FM_N8N_ROLE_EMAILS={"cfo":"cfo@company.com","ceo":"ceo@company.com","legal":"legal@company.com"}
# FM_N8N_API_EMAIL=cfo@futuremirror.demo
# FM_N8N_API_PASSWORD=
FM_EXTERNAL_ACTIONS_ENABLED=false

# Connector secrets are read from the environment only, never stored in the DB
FM_ODOO_API_KEY=
# Dynamics 365: client secret of the Entra ID app registration used by each connector
FM_D365_FO_CLIENT_SECRET=
FM_D365_BC_CLIENT_SECRET=
# SAP S/4HANA communication user password, optional REST API token, SQL database password
FM_SAP_PASSWORD=
FM_REST_TOKEN=
FM_SQL_PASSWORD=

# Backups (ops/backup.bat, ops/backup.sh): how many to keep, and an optional second location
# (another disk or a synced cloud folder), e.g. FM_BACKUP_COPY_TO=D:\FutureMirrorBackups
FM_BACKUP_KEEP=30
FM_BACKUP_COPY_TO=
# 0 = leave the project folder (code, docs, videos) out of each backup
FM_BACKUP_FILES=1
