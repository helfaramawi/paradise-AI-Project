      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "futureMirror": "Every night at 02:00 pulls the latest cost data from each connected system (D365, SAP, REST, SQL); emails only when data changed or a sync failed."
  },
