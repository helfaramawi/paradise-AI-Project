# HAQQ environment template. Never commit a real .env.
HAQQ_ENVIRONMENT=development          # set to "production" in production (enforces a real secret key, HSTS)
HAQQ_SECRET_KEY=                      # REQUIRED in production: long random string (openssl rand -hex 32)
HAQQ_DB_PASSWORD=change-me-db
HAQQ_HTTP_PORT=8090

# AI provider: "none" (deterministic engines only) or "anthropic"
HAQQ_LLM_PROVIDER=none
HAQQ_LLM_MODEL=claude-opus-5-5
HAQQ_LLM_EFFORT=medium
HAQQ_ANTHROPIC_API_KEY=               # supply via your secrets manager; never hard-code
# Each organisation must ALSO opt in (Settings → AI data policy) before any excerpt is sent externally.

# OCR (Tesseract, Arabic + English)
HAQQ_OCR_ENABLED=true
HAQQ_OCR_LANGUAGES=ara+eng

# E-mail alerts (empty host = in-app notifications only)
HAQQ_SMTP_HOST=
HAQQ_SMTP_PORT=587
HAQQ_SMTP_USER=
HAQQ_SMTP_PASSWORD=
HAQQ_SMTP_FROM=haqq@example.com

# Optional PAIS platform-operator account (commercial reporting)
HAQQ_PLATFORM_ADMIN_EMAIL=
HAQQ_PLATFORM_ADMIN_PASSWORD=

# Backups (ops\backup.bat / ops/backup.sh)
# Newest verified backups kept in haqq/backups:
HAQQ_BACKUP_KEEP=30
# Optional second copy of every backup (external disk / NAS / synced folder), e.g. E:\HAQQ-Backups
# (no comment on the same line as a value - the Windows scripts read values literally):
HAQQ_BACKUP_COPY_TO=
